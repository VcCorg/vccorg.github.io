# Copy to .env for local builds. In CI these come from repository variables.

# Where the waitlist form posts (a form service that accepts a plain HTML POST,
# e.g. Formspree, Basin, Getform, or your own endpoint). Leave empty and the page
# says the waitlist is opening soon instead of showing a form that goes nowhere.
PUBLIC_WAITLIST_ENDPOINT=

# GitHub Pages project site defaults. For a custom domain set SITE_URL to it and
# BASE_PATH to "/".
SITE_URL=https://vccorg.github.io
BASE_PATH=/keelyard-web
